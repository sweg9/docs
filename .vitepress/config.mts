import fs from 'node:fs'
import { defineConfig } from 'vitepress'

const base = '/docs/'

// Skill pages are generated by scripts/sync-harness.mjs.
function skillItems() {
  try {
    const names: string[] = JSON.parse(fs.readFileSync('standards/skills.json', 'utf8'))
    return names.map((n) => ({ text: n, link: `/standards/skills/${n}` }))
  } catch {
    return []
  }
}

